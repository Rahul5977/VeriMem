# Copy to .env and fill in. Never commit .env (rule 9).

# --- Teacher / judge: one hosted Qwen model for the whole project (rule 8) ---
# Provider is OpenAI-compatible, so the `openai` SDK talks to either one.
#   Alibaba Cloud Model Studio (intl): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Alibaba Cloud Model Studio (CN):   https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenRouter:                        https://openrouter.ai/api/v1
VERIMEM_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VERIMEM_API_KEY=
# Fixed in P0.13 after the 20-claim comparison; ask Teesha for the chosen model.
# Model Studio candidates: qwen-flash, qwen-turbo, qwen-plus, qwen-max
# OpenRouter candidates:   qwen/qwen-2.5-72b-instruct, qwen/qwen3-235b-a22b-instruct
VERIMEM_API_MODEL=TBD
# Rule 8: judge calls run with thinking off. Qwen3 on Model Studio takes
# extra_body={"enable_thinking": false}; OpenRouter takes reasoning={"enabled": false}.
VERIMEM_DISABLE_THINKING=1
# Hard spend cap in USD, set in P0.6. The cost tracker refuses calls past this.
VERIMEM_API_SPEND_CAP_USD=

# --- Web search (P0.7). Fill whichever provider you picked. ---
TAVILY_API_KEY=
SERPER_API_KEY=
VERIMEM_SEARCH_PROVIDER=tavily

# --- Optional logging ---
WANDB_API_KEY=
WANDB_PROJECT=verimem

# --- Paths (optional overrides; defaults are repo-relative) ---
# VERIMEM_CACHE_DIR=
# VERIMEM_DATA_DIR=
# VERIMEM_RESULTS_DIR=
